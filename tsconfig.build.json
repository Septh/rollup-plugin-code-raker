{
  "extends": "./tsconfig.json",
  "include": [ "source" ],
  "exclude": [ "**/zz*" ],
  "compilerOptions": {

    // Input
    "rootDir": "source",

    // Output
    "outDir": "out",
    "target": "ESNext",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "preserveConstEnums": false,
    "allowJs": false,
    "checkJs": false,
    "noEmit": false
  }
}
