{
  "name": "rollup-plugin-code-raker",
  "version": "1.1.0",
  "description": "A Rollup plugin that rakes your bundle to remove dead leaves.",
  "keywords": [
    "rollup",
    "vite",
    "plugin",
    "clean",
    "cleanup",
    "console",
    "debugger",
    "comments"
  ],
  "author": "Stephan 'Septh' Schreiber <septh@sfr.fr>",
  "homepage": "https://github.com/Septh/rollup-plugin-code-raker#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Septh/rollup-plugin-code-raker"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://patreon.com/Septh"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/septh07"
    }
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "files": [
    "dist",
    "!*.map"
  ],
  "scripts": {
    "clean": "rimraf dist out",
    "prebuild": "npm run clean",
    "build": "npm run build:js && npm run build:dts && rollup -c",
    "build:js": "tsc -p tsconfig.build.json --declaration false --declarationMap false --removeComments",
    "build:dts": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --declarationMap false --removeComments false",
    "pretest": "npm run build",
    "test": "node --import=@septh/ts-run --test \"test/**/*.test.ts\"",
    "testOnly": "npm run test --ignore-scripts"
  },
  "peerDependencies": {
    "rollup": "^4.0.0"
  },
  "dependencies": {
    "magic-string": "^0.30.12",
    "zimmerframe": "^1.1.4"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-virtual": "^3.0.2",
    "@septh/ts-run": "^2.0.0",
    "@types/estree": "^1.0.8",
    "@types/node": "^22.8.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.24.2",
    "rollup-plugin-node-externals": "^9.0.1",
    "tslib": "^2.8.0",
    "typescript": "^6.0.3"
  }
}
