{
  "name": "rollup-plugin-code-raker",
  "version": "2.1.0",
  "description": "A Rollup plugin that rakes your bundle to remove dead leaves.",
  "keywords": [
    "rollup",
    "vite",
    "plugin",
    "clean",
    "cleanup",
    "console",
    "debugger",
    "comments"
  ],
  "author": "Stephan 'Septh' Schreiber <septh@sfr.fr>",
  "homepage": "https://github.com/Septh/rollup-plugin-code-raker#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Septh/rollup-plugin-code-raker"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://patreon.com/Septh"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/septh07"
    }
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "imports": {
    "#test": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "files": [
    "dist",
    "!*.map"
  ],
  "scripts": {
    "clean": "rimraf out dist",
    "prebuild": "npm run clean",
    "build": "npm run buildOnly",
    "buildOnly": "tsc -p tsconfig.build.json && rollup -c",
    "pretest": "npm run build",
    "test": "npm run testOnly",
    "testOnly": "node --test \"test/**/*.test.ts\""
  },
  "peerDependencies": {
    "rollup": "^4.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-virtual": "^3.0.2",
    "@septh/ts-run": "^2.0.0",
    "@types/estree": "^1.0.8",
    "@types/node": "^22.8.1",
    "magic-string": "^0.30.12",
    "rimraf": "^6.0.1",
    "rollup": "^4.24.2",
    "rollup-plugin-node-externals": "^9.0.1",
    "typescript": "^6.0.3",
    "zimmerframe": "^1.1.4"
  }
}
